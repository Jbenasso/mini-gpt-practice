   "source": ["# Mini GPT Clone Demo Notebook"]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["This notebook trains the Mini GPT and visualizes the training loss + generated samples."]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from train import train\n",
    "from utils import sample_logits\n",
    "import torch\n",
    "import matplotlib.pyplot as plt\n",
    "import os"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class TinyDataset:\n",
    "    def __init__(self, text=\"hello world\"):\n",
    "        chars = sorted(list(set(text)))\n",
    "        self.stoi = {ch: i for i, ch in enumerate(chars)}\n",
    "        self.itos = {i: ch for ch, i in self.stoi.items()}\n",
    "        self.data = torch.tensor([self.stoi[c] for c in text], dtype=torch.long)\n",
    "\n",
    "    def get_batch(self, batch_size, block_size):\n",
    "        ix = torch.randint(len(self.data) - block_size, (batch_size,))\n",
    "        x = torch.stack([self.data[i:i+block_size] for i in ix])\n",
    "        y = torch.stack([self.data[i+1:i+block_size+1] for i in ix])\n",
    "        return x, y"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "dataset = TinyDataset()\n",
    "model = train(dataset)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "losses = torch.load(os.path.join(\"checkpoints\", \"losses.pt\"))\n",
    "plt.plot(losses)\n",
    "plt.xlabel(\"Step\")\n",
    "plt.ylabel(\"Loss\")\n",
    "plt.title(\"Training Loss Curve\")\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "context = torch.zeros((1, 1), dtype=torch.long)\n",
    "device = next(model.parameters()).device\n",
    "for _ in range(50):\n",
    "    logits, _ = model(context[:, -64:])\n",
    "    next_id = sample_logits(logits[:, -1, :], temperature=0.8, top_k=10)\n",
    "    context = torch.cat([context, next_id], dim=1)\n",
    "print(\"Generated:\", \"\".join(dataset.itos[i.item()] for i in context[0]))"
   ]
  }
 ]
}
